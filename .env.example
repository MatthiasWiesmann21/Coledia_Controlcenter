# ─── Database ────────────────────────────────────────────────────
# Controlcenter's OWN MySQL database (not shared with the coledia app)
DATABASE_URL="mysql://user:password@localhost:3306/coledia_controlcenter"

# ─── Auth (Better-Auth) ──────────────────────────────────────────
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
# Email verification: required in production by default; force on/off in dev:
# AUTH_REQUIRE_EMAIL_VERIFICATION="true"

# ─── Email (SMTP, e.g. Resend SMTP). Unset = emails are logged in dev ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Coledia <no-reply@coledia.ch>"

# ─── Stripe ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_CLUB="price_..."
STRIPE_PRICE_ORGANIZATION="price_..."

# ─── App (public) ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Base domain where customer containers live: https://{subdomain}.{APP_BASE_DOMAIN}
NEXT_PUBLIC_APP_BASE_DOMAIN="coledia.app"

# ─── Coledia app internal API (tenant seeding / sync) ────────────
# Any reachable coledia app container URL (shared DB), e.g. https://app.coledia.ch
APP_INTERNAL_API_URL="http://localhost:3100"
APP_INTERNAL_API_SECRET="shared-secret-must-match-apps-INTERNAL_API_SECRET"

# ─── Seed ────────────────────────────────────────────────────────
# Admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@coledia.ch"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_NAME="Coledia Admin"
# Admin notification target for provisioning requests
ADMIN_NOTIFY_EMAIL="admin@coledia.ch"
